<view class="page">
  <view class="pickup-card">
    <view class="pickup-label">取餐号</view>
    <view class="pickup-no">{{ order.pickupNo }}</view>
    <view class="pickup-status">{{ statusText }}</view>
  </view>

  <view class="section">
    <view class="section-title">商品明细</view>
    <view class="order-item" wx:for="{{ order.items }}" wx:key="productId">
      <view class="food-image">
        <image wx:if="{{ item.productImage }}" src="{{ item.productImage }}" mode="aspectFill" />
        <text wx:else>餐</text>
      </view>
      <view class="food-info">
        <view class="food-name">{{ item.productName }}</view>
        <view class="food-count">x {{ item.quantity }}</view>
      </view>
      <view class="food-price">¥{{ item.subtotal }}</view>
    </view>
    <view class="total-row">
      <text>实付金额</text>
      <text>¥{{ order.totalAmount }}</text>
    </view>
  </view>

  <view class="section">
    <view class="info-row">
      <text>订单编号</text>
      <text>{{ order.orderNo }}</text>
    </view>
    <view class="info-row">
      <text>下单时间</text>
      <text>{{ order.createTime }}</text>
    </view>
    <view class="info-row">
      <text>支付时间</text>
      <text>{{ order.payTime }}</text>
    </view>
    <view class="info-row" wx:if="{{ order.remark }}">
      <text>备注信息</text>
      <text>{{ order.remark }}</text>
    </view>
  </view>

  <view class="action-btn-wrap" wx:if="{{ order.status === 0 }}">
    <button class="action-btn cancel-btn" bindtap="confirmCancel">取消订单</button>
    <button class="action-btn pickup-btn" bindtap="confirmPickup">确认取餐</button>
  </view>
</view>
