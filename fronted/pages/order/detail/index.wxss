.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f6f6f6;
}

.pickup-card {
  padding: 34rpx 28rpx;
  border-radius: 8rpx;
  background: #ff8a2a;
  color: #fff;
  text-align: center;
}

.pickup-label {
  font-size: 28rpx;
  opacity: 0.9;
}

.pickup-no {
  margin-top: 12rpx;
  font-size: 78rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.pickup-status {
  margin-top: 10rpx;
  font-size: 28rpx;
}

.section {
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 8rpx;
  background: #fff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222;
  font-size: 30rpx;
  font-weight: 800;
}

.order-item {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.food-image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f8eee5;
  color: #c56d2c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.food-image image {
  width: 100%;
  height: 100%;
}

.food-info {
  flex: 1;
  min-width: 0;
  padding-left: 18rpx;
}

.food-name {
  color: #222;
  font-size: 28rpx;
  font-weight: 700;
}

.food-count {
  margin-top: 10rpx;
  color: #888;
  font-size: 24rpx;
}

.food-price {
  color: #e95022;
  font-size: 28rpx;
  font-weight: 700;
}

.total-row,
.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0 0;
  color: #666;
  font-size: 26rpx;
  line-height: 1.45;
}

.total-row text:last-child {
  color: #e95022;
  font-size: 32rpx;
  font-weight: 800;
}

.info-row text:first-child {
  flex: 0 0 140rpx;
  color: #888;
}

.info-row text:last-child {
  flex: 1;
  color: #222;
  text-align: right;
  word-break: break-all;
}
