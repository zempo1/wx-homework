.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 128rpx;
  background: #f6f6f6;
}

.section {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border-radius: 8rpx;
  background: #fff;
}

.section-title {
  margin-bottom: 20rpx;
  color: #222;
  font-size: 30rpx;
  font-weight: 800;
}

.order-item {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-item:last-of-type {
  border-bottom: 0;
}

.food-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f8eee5;
  color: #c56d2c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.food-image image {
  width: 100%;
  height: 100%;
}

.food-info {
  flex: 1;
  min-width: 0;
  padding-left: 18rpx;
}

.food-name {
  color: #222;
  font-size: 28rpx;
  font-weight: 700;
}

.food-count {
  margin-top: 12rpx;
  color: #888;
  font-size: 24rpx;
}

.food-price {
  color: #e95022;
  font-size: 28rpx;
  font-weight: 700;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 28rpx;
  padding-top: 22rpx;
  font-size: 28rpx;
}

.total-price {
  color: #e95022;
  font-size: 34rpx;
  font-weight: 800;
}

.remark {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #222;
  font-size: 28rpx;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  display: flex;
  align-items: center;
  background: #222;
}

.pay-total {
  flex: 1;
  padding-left: 28rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
}

.pay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 100%;
  background: #ff8a2a;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
}
